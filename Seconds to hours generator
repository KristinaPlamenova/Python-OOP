def seconds_to_time(seconds):
    hours = seconds // 3600
    minutes = (seconds % 3600) // 60
    seconds = seconds % 60

    return f"{hours:02}:{minutes:02}:{seconds:02}"


print(seconds_to_time(45))      # 00:00:45
print(seconds_to_time(3661))    # 01:01:01
print(seconds_to_time(7325))    # 02:02:05

rows, cols = [int(x) for x in input().split(' ')]

matrix = []
for i in range(rows):
        num = [int(x) for x in input().split(' ')]
        matrix.append(num)

max_sum = 0
ind = 0
for i in range(rows):
    total = 0
    for j in range(cols):
        total += matrix[i][j]
    if max_sum < total:
        max_sum = total
        ind = i

print(f'{ind},{max_sum}')

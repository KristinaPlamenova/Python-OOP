def merge(number1, number2):
    num1 = str(number1)
    num2 = str(number2)
    total = ""

    for i in range(len(num1)):
        number = int(num1[i]) + int(num2[i])
        number_as_str = str(number)
        if number > 9:
            total += number_as_str[1]
        else:
            new_num = str(number)
            total += new_num
    return print(total)

x = merge(123, 123) # x = 246
x1 = merge(789, 123) # x = 802 (7 + 1 = 8, 8 + 2 = 10, 9 + 3 = 12)
